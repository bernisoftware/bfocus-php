{
    "name": "bfocus/bfocus",
    "description": "SDK oficial do bFocus em PHP: clientes, produtos, release notes, base de conhecimento e agentes de IA pela API pública.",
    "type": "library",
    "keywords": ["bfocus", "sdk", "api", "crm", "atendimento", "base de conhecimento", "release notes"],
    "homepage": "https://bfocus.com.br",
    "license": "MIT",
    "authors": [
        {
            "name": "Berni Software",
            "homepage": "https://bfocus.com.br"
        }
    ],
    "support": {
        "source": "https://github.com/bernisoftware/bfocus-php",
        "issues": "https://github.com/bernisoftware/bfocus-php/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bfocus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bfocus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
